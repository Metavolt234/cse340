<%- include('partials/header') %>

<main>

    <h1>Create Organization</h1>

    <% if (errors && errors.length > 0) { %>
        <ul class="errors">
            <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <form action="/organizations/new-organization" method="POST">

        <label for="name">
            Organization Name
        </label>

        <input
            type="text"
            id="name"
            name="name"
            value="<%= organization.name %>"
            required
            maxlength="100">

        <label for="description">
            Description
        </label>

        <textarea
            id="description"
            name="description"
            required><%= organization.description %></textarea>

        <label for="contact_email">
            Contact Email
        </label>

        <input
            type="email"
            id="contact_email"
            name="contact_email"
            value="<%= organization.contact_email %>"
            required
            maxlength="255">

        <label for="logo_filename">
            Logo Filename
        </label>

        <input
            type="text"
            id="logo_filename"
            name="logo_filename"
            value="<%= organization.logo_filename %>"
            required
            maxlength="255">

        <button type="submit">
            Create Organization
        </button>

    </form>

</main>

<%- include('partials/footer') %>