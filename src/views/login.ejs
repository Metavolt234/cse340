<%- include("partials/header") %>


<main class="page-shell narrow-page">


    <section class="auth-card">


        <div class="auth-header">

            <span class="auth-icon">
                🔐
            </span>


            <span class="eyebrow">
                MEMBER LOGIN
            </span>


            <h1>
                Welcome Back
            </h1>


            <p>
                Sign in to continue to your dashboard.
            </p>

        </div>



        <% if (errors && errors.length > 0) { %>

            <div class="errors">

                <% errors.forEach(error => { %>

                    <p>
                        <%= error.msg %>
                    </p>

                <% }) %>

            </div>

        <% } %>



        <form
            action="/login"
            method="POST"
            class="auth-form">


            <label for="email">
                Email Address
            </label>


            <input
                type="email"
                id="email"
                name="email"
                placeholder="you@example.com"
                required
                autocomplete="email">



            <label for="password">
                Password
            </label>


            <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter your password"
                required
                autocomplete="current-password">



            <button
                class="submit-button"
                type="submit">

                Sign In

            </button>


        </form>



        <p class="auth-footer">

            Don't have an account?

            <a href="/register">
                Create one here
            </a>

        </p>


    </section>

</main>


<%- include("partials/footer") %>