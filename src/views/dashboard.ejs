<%- include("partials/header") %>

<main class="page-shell">

    <!-- =========================================
         DASHBOARD HEADER
    ========================================== -->

    <section class="page-heading">

        <span class="eyebrow">
            SERVICE NETWORK
        </span>

        <h1>
            Welcome to Your Dashboard
        </h1>

        <% if (user) { %>

            <p>
                Welcome,
                <strong><%= user.name %></strong>!
            </p>

        <% } %>

    </section>


    <!-- =========================================
         VOLUNTEER PROJECTS
    ========================================== -->

    <section class="dashboard-section">

        <div class="section-heading">

            <h2>
                My Volunteer Projects
            </h2>

            <p>
                Projects you have signed up to volunteer for.
            </p>

        </div>


        <% if (
            volunteerProjects &&
            volunteerProjects.length > 0
        ) { %>


            <div class="card-grid">

                <% volunteerProjects.forEach(project => { %>

                    <article class="content-card volunteer-card">

                        <div class="card-content">

                            <span class="eyebrow">
                                VOLUNTEER PROJECT
                            </span>


                            <h2>

                                <a
                                    href="/projects/<%= project.project_id %>"
                                >
                                    <%= project.name %>
                                </a>

                            </h2>


                            <p>
                                <%= project.description %>
                            </p>


                            <% if (project.organization_name) { %>

                                <p class="contact-line">

                                    <strong>
                                        Organization:
                                    </strong>

                                    <%= project.organization_name %>

                                </p>

                            <% } %>


                            <div class="button-row">

                                <a
                                    class="action-link secondary"
                                    href="/projects/<%= project.project_id %>"
                                >
                                    View Project
                                </a>


                                <form
                                    action="/projects/<%= project.project_id %>/remove-volunteer"
                                    method="POST"
                                    class="inline-form"
                                >

                                    <button
                                        type="submit"
                                        class="action-link danger"
                                    >
                                        Remove Volunteer
                                    </button>

                                </form>

                            </div>

                        </div>

                    </article>

                <% }) %>

            </div>


        <% } else { %>


            <!-- =========================================
                 NO VOLUNTEER PROJECTS
            ========================================== -->

            <div class="dashboard-card">

                <h2>
                    You are not volunteering for any projects yet.
                </h2>

                <p>
                    Browse the available service projects and
                    choose one that you would like to volunteer for.
                </p>


                <a
                    href="/projects"
                    class="action-link primary"
                >
                    Browse Projects
                </a>

            </div>


        <% } %>


    </section>


    <!-- =========================================
         QUICK ACTIONS
    ========================================== -->

    <section class="dashboard-section">

        <div class="section-heading">

            <h2>
                Quick Actions
            </h2>

        </div>


        <div class="button-row">

            <a
                href="/projects"
                class="action-link secondary"
            >
                View Projects
            </a>


            <a
                href="/organizations"
                class="action-link secondary"
            >
                View Organizations
            </a>


            <a
                href="/categories"
                class="action-link secondary"
            >
                View Categories
            </a>

        </div>

    </section>


</main>

<%- include("partials/footer") %>