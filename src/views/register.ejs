
<%- include("partials/header") %>


<main class="page-shell narrow-page">


    <section class="auth-card">


        <div class="auth-header">

            <span class="auth-icon">
                👤
            </span>


            <span class="eyebrow">
                JOIN THE NETWORK
            </span>


            <h1>
                Create Your Account
            </h1>


            <p>
                Register to access the CSE 340 Service Network.
            </p>

        </div>



        <% if (errors && errors.length > 0) { %>

            <div class="errors">

                <% errors.forEach(error => { %>

                    <p>
                        <%= error.msg %>
                    </p>

                <% }) %>

            </div>

        <% } %>



        <form
            action="/register"
            method="POST"
            class="auth-form">


            <label for="name">
                Full Name
            </label>


            <input
                type="text"
                id="name"
                name="name"
                value="<%= user.name || '' %>"
                placeholder="Enter your full name"
                required
                minlength="2"
                autocomplete="name">



            <label for="email">
                Email Address
            </label>


            <input
                type="email"
                id="email"
                name="email"
                value="<%= user.email || '' %>"
                placeholder="you@example.com"
                required
                autocomplete="email">



            <label for="password">
                Password
            </label>


            <input
                type="password"
                id="password"
                name="password"
                placeholder="At least 6 characters"
                minlength="6"
                required
                autocomplete="new-password">



            <button
                class="submit-button"
                type="submit">

                Create Account

            </button>


        </form>



        <p class="auth-footer">

            Already have an account?

            <a href="/login">
                Log in here
            </a>

        </p>


    </section>

</main>


<%- include("partials/footer") %>