<h1>Edit Category</h1>

<% if (errors.length > 0) { %>
<ul class="errors">
<% errors.forEach(error => { %>
<li><%= error.msg %></li>
<% }) %>
</ul>
<% } %>

<form action="/categories/edit-category/<%= category.category_id %>" method="POST">

<label for="categoryName">
Category Name
</label>

<input
type="text"
id="categoryName"
name="categoryName"
value="<%= category.name %>"
required
maxlength="100">

<button type="submit">
Update Category
</button>

</form>