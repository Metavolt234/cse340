<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <link
        rel="stylesheet"
        href="/css/main.css"
    >

</head>


<body>


<!-- =========================================
     NAVIGATION
========================================= -->

<nav>

    <ul>

        <li>
            <a href="/">Home</a>
        </li>

        <li>
            <a href="/organizations">
                Organizations
            </a>
        </li>

        <li>
            <a href="/projects">
                Projects
            </a>
        </li>

        <li>
            <a href="/categories">
                Categories
            </a>
        </li>


        <!-- =====================================
             GUEST NAVIGATION
        ====================================== -->

        <% if (!isLoggedIn) { %>

            <li>
                <a href="/register">
                    Register
                </a>
            </li>

            <li>
                <a href="/login">
                    Login
                </a>
            </li>

        <% } %>


        <!-- =====================================
             LOGGED-IN NAVIGATION
        ====================================== -->

        <% if (isLoggedIn) { %>

            <li>
                <a href="/dashboard">
                    Dashboard
                </a>
            </li>

            <li>
                <a href="/logout">
                    Logout
                </a>
            </li>

        <% } %>


    </ul>

</nav>



<!-- =========================================
     FLASH MESSAGES
========================================= -->

<%
    const messages =
        typeof flash !== "undefined"
            ? flash
            : [];
%>


<% if (messages && messages.length > 0) { %>

    <div class="flash-container">

        <% messages.forEach(message => { %>

            <div class="flash-message">

                <%= message %>

            </div>

        <% }) %>

    </div>

<% } %>



<!-- =========================================
     PAGE CONTENT 
========================================= -->