<%- include("partials/header") %>

<main class="page-shell">

```
<!-- =========================================
     PROJECT PAGE HEADER
========================================== -->

<section class="page-heading">

    <span class="eyebrow">
        COMMUNITY SERVICE
    </span>

    <h1>
        Service Projects
    </h1>

    <p>
        Explore service projects and find opportunities
        to make a difference in your community.
    </p>

    <% if (isAdmin) { %>

        <div class="category-actions">

            <a
                href="/projects/new-project"
                class="add-category-button">

                Add New Project

            </a>

        </div>

    <% } %>

</section>


<!-- =========================================
     PROJECT CARDS
========================================== -->

<% if (projects && projects.length > 0) { %>

    <section class="project-grid">

        <% projects.forEach(project => { %>

            <article class="project-card">

                <div class="project-card-content">

                    <span class="project-label">
                        SERVICE PROJECT
                    </span>


                    <h2 class="project-title">

                        <a
                            href="/projects/<%= project.project_id %>">

                            <%= project.name %>

                        </a>

                    </h2>


                    <p class="project-description">

                        <%= project.description %>

                    </p>


                    <!-- PROJECT ACTIONS -->

                    <div class="project-actions">

                        <a
                            href="/projects/<%= project.project_id %>"
                            class="action-link primary">

                            View Project

                        </a>


                        <a
                            href="/projects/<%= project.project_id %>"
                            class="action-link secondary">

                            View Details

                        </a>


                        <% if (isAdmin) { %>

                            <a
                                href="/projects/edit-project/<%= project.project_id %>"
                                class="action-link warning">

                                Edit Project

                            </a>

                        <% } %>

                    </div>

                </div>

            </article>

        <% }) %>

    </section>


<% } else { %>


    <!-- =========================================
         NO PROJECTS
    ========================================== -->

    <section class="empty-state">

        <h3>
            No Service Projects Found
        </h3>

        <p>
            There are currently no service projects
            available.
        </p>


        <% if (isAdmin) { %>

            <a
                href="/projects/new-project"
                class="action-link primary">

                Create the First Project

            </a>

        <% } %>

    </section>

<% } %>
```

</main>

<%- include("partials/footer") %>
