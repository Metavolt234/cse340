<h1>Edit Organization</h1>


<% if (errors.length > 0) { %>

<ul class="errors">

    <% errors.forEach(error => { %>

        <li><%= error.msg %></li>

    <% }) %>

</ul>

<% } %>



<form action="/organizations/edit-organization/<%= organization.organization_id %>" method="POST">


    <label for="name">
        Organization Name
    </label>

    <input
        type="text"
        id="name"
        name="name"
        value="<%= organization.name %>"
        required
        maxlength="100">



    <label for="description">
        Description
    </label>

    <textarea
        id="description"
        name="description"
        required><%= organization.description %></textarea>



    <label for="address">
        Address
    </label>

    <input
        type="text"
        id="address"
        name="address"
        value="<%= organization.address %>"
        maxlength="100">



    <label for="phone">
        Phone
    </label>

    <input
        type="tel"
        id="phone"
        name="phone"
        value="<%= organization.phone %>"
        maxlength="30">



    <label for="email">
        Email
    </label>

    <input
        type="email"
        id="email"
        name="email"
        value="<%= organization.email %>"
        maxlength="100">



    <button type="submit">
        Update Organization
    </button>


</form>