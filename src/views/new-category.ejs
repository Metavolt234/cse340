<h1>Create Category</h1>

<% if (errors.length > 0) { %>
<ul class="errors">
<% errors.forEach(error => { %>
<li><%= error.msg %></li>
<% }) %>
</ul>
<% } %>

<form action="/categories/new-category" method="POST">

<label for="categoryName">
Category Name
</label>

<input
type="text"
id="categoryName"
name="categoryName"
value="<%= categoryName %>"
required
maxlength="100">

<button type="submit">
Create Category
</button>

</form>