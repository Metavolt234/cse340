<%- include('partials/header') %>

<main class="page-container">

```
<section class="page-hero">
    <div>
        <span class="page-label">SERVICE NETWORK</span>
        <h1><%= title %></h1>
        <p>
            Explore service categories and discover opportunities
            where volunteers can make a difference.
        </p>
    </div>
</section>

<section class="content-section">

    <div class="section-heading">
        <div>
            <h2>Service Categories</h2>
            <p>Browse the different areas of community service.</p>
        </div>

        <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
            <a href="/categories" class="btn btn-primary">
                View Categories
            </a>
        <% } %>
    </div>

    <% if (categories && categories.length > 0) { %>

        <div class="card-grid">

            <% categories.forEach(category => { %>

                <article class="info-card">

                    <div class="card-icon">
                        <span>✓</span>
                    </div>

                    <div class="card-content">

                        <h3>
                            <%= category.name %>
                        </h3>

                        <% if (category.description) { %>
                            <p>
                                <%= category.description %>
                            </p>
                        <% } else { %>
                            <p>
                                Discover service opportunities
                                related to <%= category.name %>.
                            </p>
                        <% } %>

                    </div>

                </article>

            <% }) %>

        </div>

    <% } else { %>

        <div class="empty-state">

            <div class="empty-icon">📂</div>

            <h3>No Categories Available</h3>

            <p>
                There are currently no service categories
                available in the system.
            </p>

        </div>

    <% } %>

</section>
```

</main>

<%- include('partials/footer') %>
