<%- include("partials/header") %>

<main class="page-shell">

    <section class="page-heading">

        <span class="eyebrow">
            SERVICE NETWORK
        </span>

        <h1>
            Service Categories
        </h1>

        <p>
            Explore the different areas where
            community service projects are available.
        </p>


        <% if (
            typeof isAdmin !== "undefined" &&
            isAdmin
        ) { %>

            <a
                class="action-link primary"
                href="/categories/new-category">

                + Add Category

            </a>

        <% } %>

    </section>


    <section class="card-grid">

        <% if (
            categories &&
            categories.length > 0
        ) { %>


            <% categories.forEach(
                category => {
            %>

                <article class="content-card">

                    <div class="card-content">

                        <h2>

                            <a
                                href="/categories/<%= category.category_id %>"
                            >

                                <%= category.name %>

                            </a>

                        </h2>


                        <div class="button-row">

                            <a
                                class="action-link secondary"
                                href="/categories/<%= category.category_id %>"
                            >

                                View Projects

                            </a>


                            <% if (
                                typeof isAdmin !== "undefined" &&
                                isAdmin
                            ) { %>

                                <a
                                    class="action-link primary"
                                    href="/categories/edit-category/<%= category.category_id %>"
                                >

                                    Edit

                                </a>

                            <% } %>

                        </div>

                    </div>

                </article>


            <% }) %>


        <% } else { %>


            <div class="empty-state">

                <h2>
                    No Categories Found
                </h2>

                <p>
                    There are currently no service categories.
                </p>

            </div>


        <% } %>

    </section>

</main>

<%- include("partials/footer") %>